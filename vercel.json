{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/dhaw-portfolio/browser",
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/cv/:file",
      "destination": "/en/cv/:file"
    },
    {
      "source": "/fonts/:file",
      "destination": "/en/fonts/:file"
    }
  ]
}
